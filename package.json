{
  "name": "marin-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/check-bundle-size.ts",
    "preview": "tsx scripts/preview.ts",
    "analyze": "ANALYZE=true react-router build",
    "lint": "eslint . && pnpm stylelint && prettier --check .",
    "lint:fix": "prettier --write . && pnpm stylelint --fix && eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:seo": "vitest run --project seo",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "generate:tokens": "tsx scripts/generate-token-docs.ts",
    "postinstall": "tsx scripts/generate-token-docs.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:seo"
  },
  "dependencies": {
    "i18next": "^27.1.2",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "^5.0.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.104.1",
    "schema-dts": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vi-axe": "^1.1.0",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.1"
  }
}
