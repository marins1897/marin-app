{
  "name": "marin-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/check-bundle-size.ts",
    "preview": "tsx scripts/preview.ts",
    "analyze": "ANALYZE=true react-router build",
    "lint": "eslint . && pnpm stylelint && prettier --check .",
    "lint:fix": "prettier --write . && pnpm stylelint --fix && eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:seo": "vitest run --project seo",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "generate:tokens": "tsx scripts/generate-token-docs.ts",
    "postinstall": "tsx scripts/generate-token-docs.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:seo"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "isbot": "^5",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.2",
    "@react-router/node": "^8.5.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.183.0",
    "@vitest/coverage-v8": "^5.1.1",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.7",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass-embedded": "^1.108.2",
    "schema-dts": "^2.1.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vi-axe": "^1.2.1",
    "vite": "^8.3.8",
    "vite-imagetools": "^12.0.2",
    "vitest": "^5.1.1"
  }
}
