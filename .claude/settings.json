{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm stylelint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm analyze)",
      "Bash(pnpm preview)",
      "Bash(pnpm lighthouse)",
      "Bash(pnpm generate:tokens)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec stylelint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/format-changed.sh"
          }
        ]
      }
    ]
  }
}
